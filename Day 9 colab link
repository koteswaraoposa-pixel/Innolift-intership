      "source": [
        "# Capture LabelEncoders for categorical columns\n",
        "# We need to re-fit LabelEncoders to ensure consistency, as they were not saved.\n",
        "# This should ideally be part of a saved preprocessing pipeline.\n",
        "\n",
        "# Reload the original dataset to fit LabelEncoders correctly\n",
        "df_raw_for_encoders = pd.read_csv('/content/Loan_Default_Risk_Prediction_Dataset (1).csv')\n",
        "\n",
        "fitted_label_encoders = {}\n",
        "categorical_cols_original = [col for col in df_raw_for_encoders.columns if df_raw_for_encoders[col].dtype == 'object' and col != 'Loan_ID']\n",
        "\n",
        "for col in categorical_cols_original:\n",
        "    le = LabelEncoder()\n",
        "    le.fit(df_raw_for_encoders[col]) # Fit on the original, unencoded data\n",
        "    fitted_label_encoders[col] = le\n",
        "\n",
        "print(\"Fitted LabelEncoders for:\", list(fitted_label_encoders.keys()))"
      ],
      "execution_count": 30,
      "outputs": [
        {
          "output_type": "stream",
