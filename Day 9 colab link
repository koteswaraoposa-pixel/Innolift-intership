      "source": [
        "def format_prediction(y_pred, y_proba, class_labels):\n",
        "    \"\"\"\n",
        "    Converts raw model output into a human-readable dictionary.\n",
        "    \"\"\"\n",
        "    label = class_labels[y_pred]\n",
        "    # For binary classification, y_proba might be a single value for the positive class\n",
        "    # or an array [prob_neg, prob_pos]. We want the probability of the predicted class.\n",
        "    if isinstance(y_proba, (np.ndarray, list)):\n",
        "        if len(y_proba) == 2: # For binary classification [prob_class_0, prob_class_1]\n",
        "            confidence_score = y_proba[y_pred] if y_pred == 1 else y_proba[0]\n",
        "        else: # If y_proba is already the probability of the predicted class\n",
        "            confidence_score = y_proba\n",
        "    else: # If y_proba is a single value (e.g., probability of positive class)\n",
        "        confidence_score = y_proba if y_pred == 1 else (1 - y_proba)\n",
        "\n",
        "    confidence = f\"{confidence_score * 100:.1f}%\"\n",
        "\n",
        "    return {\n",
        "        'prediction': label,\n",
        "        'confidence': confidence\n",
        "    }\n",
        "\n",
        "# Define class labels for your project\n",
        "loan_default_class_labels = {0: 'Not Defaulted', 1: 'Defaulted'}\n",
        "\n",
        "# Test the function with a sample prediction from the best model\n",
        "sample_idx = 0 # Using the first test sample\n",
        "sample_y_pred = y_pred_best[sample_idx]\n",
        "sample_y_proba = y_proba_best[sample_idx] # This is the probability of class 1\n",
        "\n",
        "print(\"\\nFormatted prediction for the first test sample:\")\n",
        "formatted_output = format_prediction(sample_y_pred, [1 - sample_y_proba, sample_y_proba], loan_default_class_labels)\n",
        "display(formatted_output)"
      ],
