      "source": [
        "# Handle missing values\n",
        "print(\"\\nMissing values before cleaning:\")\n",
        "display(df.isnull().sum()[df.isnull().sum() > 0])\n",
        "\n",
        "# For simplicity, let's fill numerical missing values with the mean and categorical with the mode.\n",
        "for column in df.columns:\n",
        "    if df[column].dtype == 'object':\n",
        "        # Fill categorical with mode\n",
        "        df[column].fillna(df[column].mode()[0], inplace=True)\n",
        "    else:\n",
        "        # Fill numerical with mean\n",
        "        df[column].fillna(df[column].mean(), inplace=True)\n",
        "\n",
        "print(\"\\nMissing values after cleaning:\")\n",
        "display(df.isnull().sum()[df.isnull().sum() > 0])\n",
        "\n",
        "# Convert categorical columns to numerical using Label Encoding\n",
        "# Exclude 'Loan_ID' as it's an identifier\n",
        "for column in df.columns:\n",
        "    if df[column].dtype == 'object' and column != 'Loan_ID':\n",
        "        le = LabelEncoder()\n",
        "        df[column] = le.fit_transform(df[column])\n",
        "        print(f\"Encoded column: {column}\")\n",
        "\n",
        "print(\"\\nDataset Info after cleaning and encoding:\")\n",
        "df.info()"
