    {
      "cell_type": "code",
      "metadata": {
        "id": "ae44eb22"
      },
      "source": [
        "def run_full_prediction(raw_input: dict, model, feature_columns, class_labels, fitted_encoders):\n",
        "    \"\"\"\n",
        "    Takes a raw input dict (as if typed by a user),\n",
        "    runs it through the full pipeline,\n",
        "    and returns a human-readable result dict.\n",
        "    \"\"\"\n",
        "\n",
        "    # Step 1: Convert dict to a DataFrame (preserves column names)\n",
        "    input_df = pd.DataFrame([raw_input])\n",
        "\n",
        "    # Step 2: Apply the same preprocessing as training\n",
        "    # Apply Label Encoding for categorical features\n",
        "    for col, le in fitted_encoders.items():\n",
        "        if col in input_df.columns:\n",
        "            try:\n",
        "                input_df[col] = le.transform(input_df[col])\n",
        "            except ValueError as e:\n",
        "                print(f\"Warning: Input value '{input_df[col].iloc[0]}' for column '{col}' not seen during training. Using mode of training data labels.\")\n",
        "                # Handle unseen categories: impute with the most frequent label (mode)\n",
        "                # This ensures the input is always a valid encoded value\n",
        "                if len(le.classes_) > 0:\n",
        "                    input_df[col] = le.transform([le.classes_[0]])[0] # Use the first class as a default/mode\n",
        "                else:\n",
        "                    # Fallback if LabelEncoder was fitted on empty data (shouldn't happen with proper fitting)\n",
        "                    input_df[col] = -1 # Or some other indicator for unknown\n",
        "        else:\n",
        "            # If a categorical column from training data is missing in raw_input,\n",
        "            # add it with a default encoded value (e.g., mode of its training distribution)\n",
        "            print(f\"Warning: Categorical column '{col}' missing in raw input. Imputing with mode from training data.\")\n",
        "            if len(le.classes_) > 0:\n",
        "                input_df[col] = le.transform([le.classes_[0]])[0]\n",
        "            else:\n",
        "                input_df[col] = -1\n",
        "\n",
        "    # Step 3: Ensure all feature columns are present, in the correct order, and have matching dtypes\n",
        "    processed_input_data = {}\n",
        "    for col in feature_columns:\n",
        "        if col in input_df.columns:\n",
        "            processed_input_data[col] = input_df[col].iloc[0]\n",
        "        else:\n",
        "            # Handle missing numerical columns by imputing with the mean from training data\n",
        "            print(f\"Warning: Numerical column '{col}' missing in raw input. Imputing with mean from X_train.\")\n",
        "            processed_input_data[col] = X_train[col].mean()\n",
        "\n",
        "    # Convert to DataFrame and apply dtypes from X_train\n",
