      "source": [
        "###  Define a param_grid for your algorithm"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9e97ba69",
        "outputId": "e0f84e98-9312-4aa2-97cc-d6c89d2b1687"
      },
      "source": [
        "# Based on the best model identified (Random Forest Regressor)\n",
        "param_grid = {\n",
        "    'n_estimators': [50, 100, 200],  # Number of trees in the forest\n",
        "    'max_depth': [None, 10, 20],     # Maximum depth of the tree\n",
        "    'min_samples_split': [2, 5, 10]  # Minimum number of samples required to split an internal node\n",
        "}\n",
        "\n",
        "print(\"Parameter Grid defined for Random Forest Regressor:\")\n",
        "for param, values in param_grid.items():\n",
        "    print(f\"  {param}: {values}\")\n"
      ],
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Parameter Grid defined for Random Forest Regressor:\n",
            "  n_estimators: [50, 100, 200]\n",
            "  max_depth: [None, 10, 20]\n",
            "  min_samples_split: [2, 5, 10]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "1c23a7d4"
      },
      "source": [
        "###  Run GridSearchCV with cv=5"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ef4c199a",
        "outputId": "c964e631-0ca4-4a88-db3c-a1d1e1f30235"
      },
      "source": [
        "from sklearn.model_selection import GridSearchCV\n",
        "\n",
        "# Initialize GridSearchCV\n",
        "grid_search = GridSearchCV(estimator=baseline_model, param_grid=param_grid,\n",
        "                           cv=5, scoring='neg_mean_squared_error', n_jobs=-1, verbose=2)\n",
        "\n",
        "print(\"Starting Grid Search...\")\n",
        "# Fit GridSearchCV on the training data\n",
        "grid_search.fit(X_train, y_train)\n",
        "print(\"Grid Search complete.\")\n",
        "\n",
        "# Get the best parameters and best score\n",
        "best_params = grid_search.best_params_\n",
        "best_score = np.sqrt(-grid_search.best_score_) # Convert neg_mean_squared_error to RMSE\n",
        "\n",
        "print(f\"\\nBest parameters found: {best_params}\")\n",
        "print(f\"Best cross-validation RMSE: {best_score:.4f}\")\n",
        "\n",
        "tuned_model = grid_search.best_estimator_\n"
      ],
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Starting Grid Search...\n",
            "Fitting 5 folds for each of 27 candidates, totalling 135 fits\n",
            "Grid Search complete.\n",
            "\n",
            "Best parameters found: {'max_depth': None, 'min_samples_split': 10, 'n_estimators': 50}\n",
            "Best cross-validation RMSE: 0.4483\n"
          ]
        }
      ]
    },
