      "source": [
        "## 9. Save Best Model"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "32e975df"
      },
      "source": [
        "###  Load best_model.pkl and Record Baseline Score"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ebcd85a0",
        "outputId": "74640701-caac-4a5a-8544-a41c196197d7"
      },
      "source": [
        "# Save the best performing model\n",
        "model_filename = 'best_model.pkl'\n",
        "joblib.dump(best_model, model_filename)\n",
        "print(f\"Best model ({best_model_name}) saved as {model_filename}\")\n"
      ],
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Best model (Random Forest Regressor) saved as best_model.pkl\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "07d475ea",
        "outputId": "857db5e9-a35f-43b4-8e19-4cb4eac1924c"
      },
      "source": [
        "from sklearn.model_selection import cross_val_score\n",
        "from sklearn.metrics import mean_squared_error\n",
        "import numpy as np\n",
        "\n",
        "# Load the best model\n",
        "baseline_model = joblib.load('best_model.pkl')\n",
        "print(f\"Loaded baseline model: {baseline_model}\")\n",
        "\n",
        "# Re-test on X_test data and calculate RMSE\n",
        "y_pred_baseline = baseline_model.predict(X_test)\n",
        "rmse_baseline = np.sqrt(mean_squared_error(y_test, y_pred_baseline))\n",
        "print(f\"Baseline Model RMSE on X_test: {rmse_baseline:.4f}\")\n",
        "\n",
        "# Perform cross-validation on X_train\n",
        "# For regression, 'neg_mean_squared_error' is typically used for cross_val_score.\n",
        "# We then take the negative square root to get RMSE.\n",
        "cv_scores = cross_val_score(baseline_model, X_train, y_train,\n",
        "                            cv=5, scoring='neg_mean_squared_error', n_jobs=-1)\n",
        "rmse_cv_scores = np.sqrt(-cv_scores) # Convert to positive RMSE\n",
        "\n",
        "print(f\"\\nCross-validation RMSE scores (5-fold): {rmse_cv_scores}\")\n",
        "print(f\"Mean CV RMSE: {rmse_cv_scores.mean():.4f}\")\n",
        "print(f\"Standard Deviation CV RMSE: {rmse_cv_scores.std():.4f}\")\n"
      ],
      "execution_count": 16,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded baseline model: RandomForestRegressor(n_jobs=-1, random_state=42)\n",
            "Baseline Model RMSE on X_test: 0.4312\n",
            "\n",
            "Cross-validation RMSE scores (5-fold): [0.409176   0.45682327 0.43290804 0.54312752 0.41200349]\n",
            "Mean CV RMSE: 0.4508\n",
            "Standard Deviation CV RMSE: 0.0492\n"
          ]
        }
      ]
    },
