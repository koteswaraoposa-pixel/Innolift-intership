      },
      "source": [
        "from sklearn.ensemble import GradientBoostingClassifier\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix\n",
        "\n",
        "# Initialize and train the Gradient Boosting Classifier model\n",
        "gbr_model = GradientBoostingClassifier(random_state=42)\n",
        "gbr_model.fit(X_train, y_train)\n",
        "\n",
        "# Make predictions on the test set\n",
        "gbr_predictions = gbr_model.predict(X_test)\n",
        "\n",
        "# Evaluate the model\n",
        "gbr_accuracy = accuracy_score(y_test, gbr_predictions)\n",
        "gbr_precision = precision_score(y_test, gbr_predictions, zero_division=0)\n",
        "gbr_recall = recall_score(y_test, gbr_predictions, zero_division=0)\n",
        "gbr_f1 = f1_score(y_test, gbr_predictions, zero_division=0)\n",
        "gbr_conf_matrix = confusion_matrix(y_test, gbr_predictions)\n",
        "\n",
        "print(f\"Gradient Boosting Classifier Accuracy: {gbr_accuracy:.4f}\")\n",
        "print(f\"Gradient Boosting Classifier Precision: {gbr_precision:.4f}\")\n",
        "print(f\"Gradient Boosting Classifier Recall: {gbr_recall:.4f}\")\n",
        "print(f\"Gradient Boosting Classifier F1-Score: {gbr_f1:.4f}\")"
